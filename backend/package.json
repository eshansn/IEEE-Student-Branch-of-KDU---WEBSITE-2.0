{
  "name": "kdu-ieee-backend",
  "version": "1.0.0",
  "description": "Backend system for IEEE KDU website with admin panel",
  "main": "dist/server.js",
  "scripts": {
    "dev": "nodemon --exec \"ts-node --transpile-only\" src/server.ts",
    "build": "tsc",
    "start": "node dist/server.js",
    "vercel-build": "npm run build",
    "admin:dev": "cd admin && npm run dev",
    "admin:build": "cd admin && npm run build",
    "setup": "npm install && cd admin && npm install"
  },
  "keywords": [
    "ieee",
    "kdu",
    "backend",
    "admin"
  ],
  "author": "IEEE KDU Team",
  "license": "MIT",
  "dependencies": {
    "@types/sharp": "^0.32.0",
    "axios": "^1.12.2",
    "bcryptjs": "^2.4.3",
    "cloudinary": "^1.41.3",
    "compression": "^1.7.4",
    "cors": "^2.8.5",
    "dotenv": "^16.3.1",
    "express": "^4.18.2",
    "express-rate-limit": "^7.1.5",
    "helmet": "^7.1.0",
    "joi": "^17.11.0",
    "jsonwebtoken": "^9.0.2",
    "mongoose": "^8.0.0",
    "multer": "^1.4.5-lts.1",
    "multer-storage-cloudinary": "^4.0.0",
    "nodemailer": "^6.10.1",
    "sharp": "^0.32.6"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/compression": "^1.7.5",
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/jsonwebtoken": "^9.0.6",
    "@types/multer": "^1.4.11",
    "@types/node": "^20.10.0",
    "@types/nodemailer": "^6.4.21",
    "@vercel/node": "^3.2.29",
    "mongodb-memory-server": "^10.2.1",
    "nodemon": "^3.0.2",
    "ts-node": "^10.9.1",
    "typescript": "^5.3.2"
  }
}
